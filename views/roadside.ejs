<%- include('partials/header') %>

<div class="page-content">
  <div class="page-header">
    <div>
      <h1 class="page-title">Roadside Assistance</h1>
      <p class="page-subtitle">Emergency contacts and help requests</p>
    </div>
  </div>

  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <!-- Emergency Contacts -->
  <div class="section">
    <h2 class="section-title">📞 Emergency Contacts</h2>
    <div class="contacts-grid">
      <% emergencyContacts.forEach(contact => { %>
        <div class="contact-card">
          <div class="contact-icon"><%= contact.icon %></div>
          <div class="contact-info">
            <div class="contact-name"><%= contact.name %></div>
            <div class="contact-desc"><%= contact.description %></div>
          </div>
          <a href="tel:<%= contact.number %>" class="contact-number"><%= contact.number %></a>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Request Help Section -->
  <div class="section">
    <h2 class="section-title">🆘 Request Roadside Help</h2>
    <div class="form-card">
      <form action="/roadside/request" method="POST" class="form-grid">
        <div class="form-group form-full">
          <label for="helpType">Type of Help Needed *</label>
          <select id="helpType" name="helpType" required>
            <option value="">Select help type</option>
            <option value="Flat Tyre">🔴 Flat Tyre</option>
            <option value="Battery Jump Start">🔋 Battery Jump Start</option>
            <option value="Out of Fuel">⛽ Out of Fuel</option>
            <option value="Towing">🚛 Towing Required</option>
            <option value="Accident">⚠️ Accident / Breakdown</option>
            <option value="Lockout">🔑 Locked Out of Car</option>
            <option value="Other">❓ Other Emergency</option>
          </select>
        </div>

        <div class="form-group form-full">
          <label for="location">Your Current Location *</label>
          <input type="text" id="location" name="location" placeholder="e.g. NH-44, near Bhopal Toll, MP" required />
        </div>

        <div class="form-group form-full">
          <label for="description">Additional Details</label>
          <textarea id="description" name="description" rows="3" placeholder="Describe your situation..."></textarea>
        </div>

        <div class="form-actions form-full">
          <button type="submit" class="btn-danger btn-full">🆘 Send Help Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Safety Tips -->
  <div class="section">
    <h2 class="section-title">💡 Safety Tips</h2>
    <div class="tips-grid">
      <div class="tip-card">
        <div class="tip-icon">⚠️</div>
        <p>Turn on hazard lights immediately if breaking down on a highway</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">🦺</div>
        <p>Always keep a reflective triangle and safety vest in your car</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">📍</div>
        <p>Note your exact location using GPS before calling for help</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">🔒</div>
        <p>Stay inside the car with doors locked if on a busy highway</p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
