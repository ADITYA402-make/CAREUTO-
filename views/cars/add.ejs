<%- include('../partials/header') %>

<div class="page-content">
  <div class="page-header">
    <div>
      <h1 class="page-title">Add New Car</h1>
      <p class="page-subtitle">Register a new vehicle to your garage</p>
    </div>
    <a href="/cars" class="btn-outline">← Back</a>
  </div>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="form-card">
    <form action="/cars/add" method="POST" class="form-grid">
      <div class="form-group">
        <label for="car_name">Car Brand / Name *</label>
        <input type="text" id="car_name" name="car_name" placeholder="e.g. Maruti Suzuki, Honda" required />
      </div>

      <div class="form-group">
        <label for="model">Model *</label>
        <input type="text" id="model" name="model" placeholder="e.g. Swift, City, Fortuner" required />
      </div>

      <div class="form-group">
        <label for="number_plate">Registration Number *</label>
        <input type="text" id="number_plate" name="number_plate" placeholder="e.g. MP04 AB 1234" required style="text-transform:uppercase" />
      </div>

      <div class="form-group">
        <label for="year">Manufacturing Year *</label>
        <input type="number" id="year" name="year" placeholder="e.g. 2020" min="1990" max="2025" required />
      </div>

      <div class="form-group form-full">
        <label for="fuel_type">Fuel Type *</label>
        <select id="fuel_type" name="fuel_type" required>
          <option value="">Select fuel type</option>
          <option value="Petrol">⛽ Petrol</option>
          <option value="Diesel">🛢️ Diesel</option>
          <option value="CNG">🌿 CNG</option>
          <option value="Electric">⚡ Electric</option>
          <option value="Hybrid">🔋 Hybrid</option>
        </select>
      </div>

      <div class="form-actions form-full">
        <a href="/cars" class="btn-outline">Cancel</a>
        <button type="submit" class="btn-primary">Add Car 🚘</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
