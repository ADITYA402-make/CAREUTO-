<%- include('../partials/header') %>

<div class="page-content">
  <div class="page-header">
    <div>
      <h1 class="page-title">My Cars</h1>
      <p class="page-subtitle">Manage all your registered vehicles</p>
    </div>
    <a href="/cars/add" class="btn-primary">+ Add Car</a>
  </div>

  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (cars.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🚗</div>
      <h3>No cars added yet</h3>
      <p>Click "Add Car" to register your first vehicle.</p>
      <a href="/cars/add" class="btn-primary">Add My First Car</a>
    </div>
  <% } else { %>
    <div class="cars-grid cars-grid-large">
      <% cars.forEach(car => { %>
        <div class="car-card-full">
          <div class="car-card-top">
            <div class="car-big-icon">🚘</div>
            <span class="fuel-badge fuel-<%= car.fuel_type.toLowerCase() %>"><%= car.fuel_type %></span>
          </div>
          <div class="car-card-info">
            <h3 class="car-name"><%= car.car_name %></h3>
            <div class="car-details-grid">
              <div class="car-detail">
                <span class="detail-label">Model</span>
                <span class="detail-value"><%= car.model %></span>
              </div>
              <div class="car-detail">
                <span class="detail-label">Year</span>
                <span class="detail-value"><%= car.year %></span>
              </div>
              <div class="car-detail">
                <span class="detail-label">Fuel</span>
                <span class="detail-value"><%= car.fuel_type %></span>
              </div>
              <div class="car-detail">
                <span class="detail-label">Plate</span>
                <span class="detail-value plate-text"><%= car.number_plate %></span>
              </div>
            </div>
          </div>
          <div class="car-card-actions">
            <a href="/services/add?car_id=<%= car.id %>" class="btn-small btn-outline">🔧 Add Service</a>
            <a href="/insurance/add?car_id=<%= car.id %>" class="btn-small btn-outline">🛡️ Add Insurance</a>
            <a href="/cars/<%= car.id %>/edit" class="btn-small btn-primary">✏️ Edit</a>
            <form action="/cars/<%= car.id %>/delete" method="POST" onsubmit="return confirm('Delete this car and all its records?')">
              <button type="submit" class="btn-small btn-danger">🗑️ Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
